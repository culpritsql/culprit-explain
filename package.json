{
  "name": "culprit-explain",
  "private": true,
  "version": "0.6.0",
  "description": "Free client-side SQL execution plan visualizer, structural plan comparator, deadlock graph analyzer, and Extended Events (.xel) inspector powered by WebAssembly.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-prerender.tsx --outDir dist-ssr",
    "build": "bun run typecheck && bun run build:client && bun run build:ssr && node scripts/prerender-seo.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@culpritsql/plan-viewer": "0.6.0",
    "@culpritsql/plans": "0.6.7",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
